# Copy to .env — Bun loads it automatically.

# Signs the admin cookie. Any long random string:
#   openssl rand -base64 32
SESSION_SECRET=

# The dashboard password, as scrypt:<saltHex>:<keyHex>. Print one with:
#   bun -e 'const c=require("node:crypto"),s=c.randomBytes(16);console.log("scrypt:"+s.toString("hex")+":"+c.scryptSync(process.argv[1],s,64).toString("hex"))' 'your-password'
ADMIN_PASSWORD_HASH=

# Every origin allowed to call this API, comma-separated — the dashboard plus any other server or app.
# Matched against the Origin header verbatim, so no trailing slash, and include the port in dev. This is
# both the CORS allowance and the CSRF check.
NEXT_PUBLIC_ORIGIN=https://your.com

# Optional.
# PORT=8787
# DB_PATH=data/keys.db   # created on boot, along with its -wal and -shm siblings
